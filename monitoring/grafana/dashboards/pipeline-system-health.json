{
  "uid": "job-agg-pipeline-health",
  "title": "Pipeline & System Health",
  "description": "LangGraph node timings, task error budget, checkpoint latency, and backing service reachability.",
  "tags": ["job-aggregator", "pipeline", "health"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-12h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Worker scrape status",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"job-aggregator-worker\"})",
          "legendFormat": "worker"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last cycle duration",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 1 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pipeline_cycle_duration_seconds_sum[$__range])) / clamp_min(sum(increase(pipeline_cycle_duration_seconds_count[$__range])), 1)",
          "legendFormat": "mean cycle"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Task success rate",
      "description": "Successful node executions as a share of all executions. Error budget: 99.5%.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.995 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pipeline_tasks_total{status=\"success\"}[$__range])) / clamp_min(sum(increase(pipeline_tasks_total[$__range])), 1)",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed tasks",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pipeline_tasks_total{status=\"failure\"}[$__range]))",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node execution time (p95)",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(pipeline_node_duration_seconds_bucket[10m])))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Slowest nodes (p95, range)",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(pipeline_node_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Task failures by node",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (increase(pipeline_tasks_total{status=\"failure\"}[5m]))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Checkpoint & indexing latency (p95)",
      "description": "MongoDB checkpoint writes by MongoDBSaver, alongside the embed_jobs node that performs OpenSearch bulk indexing.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mongo_checkpoint_duration_seconds_bucket[10m])))",
          "legendFormat": "mongo checkpoint write"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pipeline_node_duration_seconds_bucket{node=\"embed_jobs\"}[10m])))",
          "legendFormat": "embed_jobs (OpenSearch bulk index)"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Backing service reachability",
      "description": "Published by the API readiness probe; scrape /readyz to refresh.",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "UNREACHABLE", "color": "red", "index": 0 },
                "1": { "text": "OK", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (dependency) (dependency_up)",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API request rate by status",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "job-aggregator-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
