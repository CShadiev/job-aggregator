# Operator configuration for the job-aggregator API and pipeline.
# Copy to .env and fill the required values. See docs/architecture.md.
# Optional tuning variables are commented out so an empty file does not
# override the defaults in config.py.

# --- Required ---

OPENAI_API_KEY=
GROK_API_KEY=
DEEPINFRA_API_KEY=
APIFY_API_KEY=

MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_PORT=

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_NAME=

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

APIFY_LINKEDIN_TASK_ID=
APIFY_LINKEDIN_PL_TASK_ID=
APIFY_LINKEDIN_UK_TASK_ID=

# --- Optional tuning (defaults apply when unset) ---

# DEDUPLICATION_BATCH_SIZE=
# DEDUPLICATION_MODEL=
# Config default is glm-5.3-flash. The live environment still sets gpt-5.6-luna.
# SCREENING_MODEL=
# FIT_ASSESSMENT_MODEL=
# COVER_LETTER_MODEL=
# COVER_LETTER_MIN_CV_SCORE=
# PIPELINE_PAIR_CONCURRENCY=
# PIPELINE_SCHEDULE_SECONDS=
# ARBEITNOW_MAX_PAGES=
# DEBUG_MODE=
# LOG_DIR=
# TEMP_DIR=
# METRICS_ENABLED=
# WORKER_METRICS_HOST=
# WORKER_METRICS_PORT=
# PRICING_CACHE_TTL_SECONDS=
# MONGODB_JOBS_COLLECTION=
# MONGODB_SCREENINGS_COLLECTION=
# MONGODB_ASSESSMENTS_COLLECTION=
# MONGODB_JOB_APPLICATIONS_COLLECTION=
# MONGODB_USER_PROFILES_COLLECTION=
# MONGODB_CHECKPOINTS_COLLECTION=
# MONGODB_FAILED_TASKS_COLLECTION=
# MONGODB_PRICING_COLLECTION=
